# Database — PostgreSQL (local via docker compose, or Railway Postgres plugin)
# Local:
#   docker compose up -d
DATABASE_URL="postgresql://pocket:pocket@localhost:5432/pocket_console?schema=public"

# Railway: leave unset — the Postgres plugin injects DATABASE_URL automatically.

# Server
PORT=3000
NODE_ENV=development

# Optional: point the browser at a remote Socket.IO host.
# Leave unset to use the same origin (recommended for Railway + local hosting).
# NEXT_PUBLIC_SOCKET_URL="https://your-app.up.railway.app"

# Set automatically by `npm run host`
# POCKET_HOST=1

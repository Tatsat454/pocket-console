# Database — SQLite for local development
DATABASE_URL="file:./dev.db"

# Production example (PostgreSQL):
# DATABASE_URL="postgresql://user:password@localhost:5432/pocket_console?schema=public"

# Server
PORT=3000
NODE_ENV=development

# Optional: point the browser at a remote Socket.IO host.
# Leave unset to use the same origin (recommended for local-network hosting).
# NEXT_PUBLIC_SOCKET_URL="http://192.168.1.20:3000"

# Set automatically by `npm run host`
# POCKET_HOST=1
